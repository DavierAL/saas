# ============================================================
# SaaS POS — Mobile Environment Variables Example
# Copy to .env.local (never commit to git)
# ============================================================

# ─── Supabase ────────────────────────────────────────────────
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJ...YOUR_ANON_KEY...

# ─── PowerSync ───────────────────────────────────────────────
EXPO_PUBLIC_POWERSYNC_URL=https://YOUR_INSTANCE.powersync.journeyapps.com

# ─── Environment ─────────────────────────────────────────────
NODE_ENV=development