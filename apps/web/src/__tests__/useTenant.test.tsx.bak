import { renderHook, act, waitFor } from '@testing-library/react';
import { useTenant } from '../../hooks/useTenant';
import { useCases } from '../../lib/use-cases';
import type { Tenant } from '@saas-pos/domain';
import { tenantBuilder } from '@saas-pos/domain';

// Mock de useCases
jest.mock('../../lib/use-cases', () => ({
  useCases: {
    tenant: {
      findById: jest.fn(),
    },
  },
}));

// Mock de Supabase (necesario si el hook lo usa internamente)
jest.mock('../../lib/supabase', () => ({
  supabase: {
    auth: {
      getUser: jest.fn(),
    },
  },
}));

describe('useTenant', () => {
  const mockTenant: Tenant = tenantBuilder()
    .withId('tenant-1')
    .withName('Test Restaurant')
    .active()
    .build();

  beforeEach(() => {
    jest.clearAllMocks();
  });

  test('fetches tenant data when tenantId is provided', async () => {
    (useCases.tenant.findById as jest.Mock).mockResolvedValue(mockTenant);

    const { result } = renderHook(() => useTenant('tenant-1'));

    await waitFor(() => {
      expect(result.current.loading).toBe(false);
    });

    expect(useCases.tenant.findById).toHaveBeenCalledWith('tenant-1');
    expect(result.current.tenant).toEqual(mockTenant);
    expect(result.current.error).toBeNull();
  });

  test('returns null tenant when tenantId is null', async () => {
    const { result } = renderHook(() => useTenant(null));

    await waitFor(() => {
      expect(result.current.loading).toBe(false);
    });

    expect(useCases.tenant.findById).not.toHaveBeenCalled();
    expect(result.current.tenant).toBeNull();
  });

  test('returns null tenant when tenantId is undefined', async () => {
    const { result } = renderHook(() => useTenant(undefined));

    await waitFor(() => {
      expect(result.current.loading).toBe(false);
    });

    expect(result.current.tenant).toBeNull();
  });

  test('sets loading to true while fetching', async () => {
    (useCases.tenant.findById as jest.Mock).mockImplementation(
      () => new Promise((resolve) => setTimeout(() => resolve(mockTenant), 100))
    );

    const { result } = renderHook(() => useTenant('tenant-1'));

    // Initially loading should be true
    expect(result.current.loading).toBe(true);
  });

  test('sets error state when fetch fails', async () => {
    const errorMsg = 'Network error';
    (useCases.tenant.findById as jest.Mock).mockRejectedValue(
      new Error(errorMsg)
    );

    const { result } = renderHook(() => useTenant('tenant-1'));

    await waitFor(() => {
      expect(result.current.loading).toBe(false);
    });

    expect(result.current.error).toBe(errorMsg);
    expect(result.current.tenant).toBeNull();
  });

  test('returns expired tenant correctly', async () => {
    const expiredTenant: Tenant = tenantBuilder()
      .withId('tenant-1')
      .expired()
      .build();
    (useCases.tenant.findById as jest.Mock).mockResolvedValue(expiredTenant);

    const { result } = renderHook(() => useTenant('tenant-1'));

    await waitFor(() => {
      expect(result.current.loading).toBe(false);
    });

    expect(result.current.tenant?.valid_until).toBeDefined();
  });

  test('respects tenantId changes and refetches', async () => {
    const tenant1 = { ...mockTenant, id: 'tenant-1' };
    const tenant2 = { ...mockTenant, id: 'tenant-2' };

    (useCases.tenant.findById as jest.Mock)
      .mockResolvedValueOnce(tenant1)
      .mockResolvedValueOnce(tenant2);

    const { result, rerender } = renderHook(
      ({ tenantId }) => useTenant(tenantId),
      { initialProps: { tenantId: 'tenant-1' } }
    );

    await waitFor(() => {
      expect(result.current.tenant?.id).toBe('tenant-1');
    });

    rerender({ tenantId: 'tenant-2' });

    await waitFor(() => {
      expect(result.current.tenant?.id).toBe('tenant-2');
    });

    expect(useCases.tenant.findById).toHaveBeenCalledTimes(2);
  });
});